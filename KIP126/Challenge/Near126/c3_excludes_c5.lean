/-! The C₃ condition excludes C₅ in the near-126 argument. -/
namespace KIP126.Challenge.Near126.C3NotC5

open KIP126.Kervaire

/-- Under the near-126 hypotheses, `C₃` excludes `C₅`. -/
theorem c3_excludes_c5 [D : Near126Adams] :
